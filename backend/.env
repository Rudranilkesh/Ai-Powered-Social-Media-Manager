# ============================================================
# SocialSync AI — Backend Environment Variables
# Fill in actual values before running the server.
# NEVER commit this file to GitHub — it is in .gitignore
# ============================================================

# ── Server ──
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ──
MONGODB_URI=your_mongodb_atlas_connection_string_here

# ── JWT Authentication ──
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# ── Google Gemini AI ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Cloudinary (Media Upload) ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Ayrshare (Social Media Publishing) ──
AYRSHARE_API_KEY=your_ayrshare_api_key_here

# ── Encryption Key (for storing social account credentials) ──
ENCRYPTION_KEY=your_exactly_32_character_encryption_key

# ── Frontend URL (for CORS) ──
CLIENT_URL=http://localhost:5173
